{
  "name": "inite-billing-service",
  "version": "1.3.0",
  "description": "INITE Billing Service - Payment-rail agnostic billing and subscriptions",
  "author": "INITE (https://inite.ai)",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "homepage": "https://github.com/inite-ai/inite-billing-service#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inite-ai/inite-billing-service.git"
  },
  "bugs": {
    "url": "https://github.com/inite-ai/inite-billing-service/issues"
  },
  "keywords": [
    "billing",
    "payments",
    "subscriptions",
    "credits",
    "entitlements",
    "nestjs",
    "stripe",
    "crypto",
    "self-hosted"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "bash scripts/test.sh",
    "test:ci": "jest --forceExit --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --forceExit",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:watch": "jest --config ./test/jest-e2e.json --watch",
    "eval": "RUN_AI_EVALS=1 jest --config ./test/eval/jest-eval.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "prepare": "husky || true"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.9.1",
    "@types/cookie-parser": "^1.4.10",
    "bullmq": "^5.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.3.2",
    "jose": "^6.2.2",
    "jwks-rsa": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jest": "^30.5.0",
    "prettier": "^3.9.5",
    "prisma": "^5.9.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.68.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(jose)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.(t|j)s",
      "!src/main.ts",
      "!src/**/*.module.ts",
      "!src/**/*.dto.ts",
      "!src/**/*.interface.ts"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setup-e2e.ts"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 38,
        "branches": 18,
        "functions": 27,
        "lines": 38
      },
      "./src/payment-orchestrator/": {
        "statements": 85,
        "branches": 70,
        "functions": 90,
        "lines": 85
      },
      "./src/workers/": {
        "statements": 80,
        "branches": 55,
        "functions": 80,
        "lines": 80
      },
      "./src/webhooks/": {
        "statements": 80,
        "branches": 50,
        "functions": 75,
        "lines": 80
      },
      "./src/checkout/": {
        "statements": 65,
        "branches": 50,
        "functions": 50,
        "lines": 65
      },
      "./src/credits/": {
        "statements": 60,
        "branches": 45,
        "functions": 40,
        "lines": 60
      },
      "./src/affiliates/": {
        "statements": 50,
        "branches": 30,
        "functions": 45,
        "lines": 50
      },
      "./src/common/": {
        "statements": 85,
        "branches": 55,
        "functions": 75,
        "lines": 85
      }
    }
  }
}
