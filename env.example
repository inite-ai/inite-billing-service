# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inite_billing?schema=billing

# Redis
# Matches the host port exposed by docker-compose (redis: "6380:6379").
REDIS_URL=redis://localhost:6380

# Private keys at rest. Billing seals the keys it keeps (the x402 relayer's
# Turnkey API key, agents' wallet keys) with AES-256-GCM under this secret.
# REQUIRED for wallets and x402: 32 random bytes, base64 (`openssl rand -base64 32`).
# Keep a copy outside the server — a lost secret is a lost key.
KEY_SEAL_SECRET=

# JWT Authentication — the rules are the INITE Triad token contract:
# https://github.com/inite-ai/inite-triad/blob/main/docs/compatibility.md
# Dev only (NODE_ENV != production): HS256 with a shared secret.
JWT_SECRET=your-jwt-secret-key-here
# The `iss` claim this service accepts. REQUIRED in production: unset, any token
# the configured JWKS can verify is accepted, whoever issued it. It is INITE
# Auth's JWT_ISSUER — the value inside the token, which is not necessarily the
# same host as AUTH_SERVICE_URL (INITE's own: https://auth-api.inite.ai, keys at
# https://auth.inite.ai). Comma-separate old,new while an issuer moves; a
# trailing slash does not matter.
JWT_ISSUER=https://auth.example.com

# Accepted `aud` values (comma-separated). INITE Auth puts `aud` on every access
# token: the client id it was issued to (the billing frontend: inite-billing),
# or the RFC 8707 resource a client asked for. When set, billing's own resources
# (<FRONTEND_URL>/mcp, /mcp/wallet, /v1/agent-wallet) are always accepted too.
# Optional for now (a production boot warns when unset); it becomes required in
# the next minor.
# JWT_AUDIENCE=inite-billing

# Identity provider (JWKS). REQUIRED in production: end-user JWTs are verified
# against {AUTH_SERVICE_URL}/.well-known/jwks.json. Point this at your own auth
# provider when self-hosting — there is no default, so a missing value fails at
# startup rather than silently trusting someone else's keys. In local dev you
# can set JWT_SECRET instead (HS256) and leave this unset.
AUTH_SERVICE_URL=https://auth.example.com

# Public URL of the frontend UI — used to build checkout redirect, affiliate,
# and email links. In local dev the frontend runs on :3001. If unset it falls
# back to localhost:3001 with a warning, so deployed links do not silently
# point at another installation.
FRONTEND_URL=http://localhost:3001

# Allowed CORS origins (comma-separated). Defaults to http://localhost:3001.
CORS_ORIGINS=http://localhost:3001

# Service API keys are auto-generated per service in the database
# Configure them via the admin UI

# Payment provider credentials are stored in the database (payment_providers.config)
# Configure them via the admin UI

# Anthropic (AI assistant)
ANTHROPIC_API_KEY=
# Model alias or pinned snapshot, e.g. claude-sonnet-4-5 or claude-sonnet-4-5-20250929
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_MAX_TOKENS=2048
# Leave empty to use the model default
ANTHROPIC_TEMPERATURE=
ASSISTANT_ACTION_TTL_MINUTES=15

# Email / notifications (Resend)
RESEND_API_KEY=
# Required when NOTIFICATIONS_EMAIL_ENABLED=true. Must be a sender on a
# domain you have verified with the provider.
EMAIL_FROM="Acme Billing <billing@acme.example>"
EMAIL_REPLY_TO=
# Master kill-switch for outgoing email
NOTIFICATIONS_EMAIL_ENABLED=false
RESEND_WEBHOOK_SECRET=

# AI outreach (dunning / win-back / abandoned checkout)
OUTREACH_ENABLED=false
OUTREACH_TRIGGERS=abandoned_checkout,dunning,winback,trial_ending
OUTREACH_MAX_PER_USER_7D=3
OUTREACH_DEFAULT_LOCALE=en
# Optional model override for outreach generation (defaults to ANTHROPIC_MODEL)
OUTREACH_MODEL=

# Embeddings / semantic search (OpenAI)
OPENAI_API_KEY=
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_ENABLED=false

# Recommendations
RECS_LLM_EXPLAIN=false

# Risk / fraud signals (monitor-only unless blocking enabled)
RISK_BLOCKING_ENABLED=false
RISK_FLAG_THRESHOLD=60
RISK_BLOCK_THRESHOLD=85
RISK_MAX_ORDERS_PER_HOUR=5
RISK_ABS_AMOUNT_CAP=10000
RISK_NEW_USER_AMOUNT=500

# Server
PORT=3000
NODE_ENV=development


