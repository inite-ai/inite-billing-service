# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inite_billing?schema=billing

# Redis
REDIS_URL=redis://localhost:6381

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-here
# OR use public key for RS256
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Service-to-Service Authentication
SERVICE_API_KEY=your-service-api-key-here

# ONE Payment Rail
ONE_API_BASE_URL=https://api.one.lat
ONE_API_KEY=your-one-api-key
ONE_API_SECRET=your-one-api-secret

# Webhook URLs (for webhook callbacks)
BILLING_WEBHOOK_URLS=https://your-domain.com/webhooks/one,https://your-domain.com/webhooks/crypto

# Crypto Adapter (optional)
FEATURE_CRYPTO_MODE=ONCHAIN_INVOICE
# FEATURE_CRYPTO_MODE=ONE_CRYPTO

# Server
PORT=3000
NODE_ENV=development

