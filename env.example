# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inite_billing?schema=billing

# Redis
REDIS_URL=redis://localhost:6381

# JWT Authentication
JWT_SECRET=your-jwt-secret-key-here
# OR use public key for RS256
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Service API keys are auto-generated per service in the database
# Configure them via the admin UI

# Payment provider credentials are stored in the database (payment_providers.config)
# Configure them via the admin UI

# Server
PORT=3000
NODE_ENV=development

