# ─── Frontend (Next.js) environment ───────────────────────────────────────────
# Copy to `.env.local` and adjust. NEXT_PUBLIC_* values are inlined into the
# browser bundle (never put secrets there). The unprefixed values are read only
# by the server-side auth routes (app/api/auth/*) and stay on the server.

# Base URL of the billing backend API (NestJS). Local dev: http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# Canonical public URL of this frontend (used for SEO/OG metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ─── OAuth / identity provider (Authorization Code + PKCE) ─────────────────────
# Client-visible values used to start the login redirect.
NEXT_PUBLIC_AUTH_SERVICE_URL=https://auth.inite.ai
NEXT_PUBLIC_OAUTH_CLIENT_ID=inite-billing

# Server-only values used by the token-exchange / refresh routes. If unset they
# fall back to the NEXT_PUBLIC_* equivalents above. OAUTH_CLIENT_SECRET is only
# needed for a confidential client — leave empty for a public (PKCE-only) client.
AUTH_SERVICE_URL=https://auth.inite.ai
OAUTH_CLIENT_ID=inite-billing
OAUTH_CLIENT_SECRET=
