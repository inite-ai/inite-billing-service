// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["billing", "public"]
}

// Billing schema - payment-rail agnostic billing and subscriptions

enum ProductType {
  subscription
  one_time
  usage

  @@schema("billing")
}

enum OrderMode {
  PAYMENT
  SUBSCRIPTION

  @@schema("billing")
}

enum OrderStatus {
  created
  open
  paid
  failed
  refunded
  expired

  @@schema("billing")
}

enum IntentStatus {
  created
  opened
  paid
  failed
  expired
  refunded

  @@schema("billing")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  ended

  @@schema("billing")
}

enum EntitlementStatus {
  active
  revoked
  expired

  @@schema("billing")
}

enum EntitlementSource {
  subscription
  order
  admin

  @@schema("billing")
}

enum InvoiceStatus {
  open
  paid
  void
  failed
  refunded

  @@schema("billing")
}

enum WebhookEventStatus {
  received
  processing
  processed
  failed

  @@schema("billing")
}

enum OutboxEventStatus {
  new
  sent
  failed

  @@schema("billing")
}

model Service {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true) @map("is_active")
  metadata  Json?    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products       Product[]
  referralLevels ReferralLevel[]
  affiliates     Affiliate[]
  referrals      Referral[]

  @@map("services")
  @@schema("billing")
}

model ReferralLevel {
  id             String   @id @default(uuid()) @db.Uuid
  serviceId      String   @map("service_id") @db.Uuid
  level          Int
  commissionRate Decimal  @map("commission_rate") @db.Decimal(5, 4)
  name           String   @db.VarChar(100)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id])

  @@unique([serviceId, level])
  @@map("referral_levels")
  @@schema("billing")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique @db.VarChar(100)
  name        String      @db.VarChar(255)
  serviceId   String?     @map("service_id") @db.Uuid
  moduleScope String      @map("module_scope") @db.VarChar(100)
  type        ProductType
  isActive    Boolean     @default(true) @map("is_active")
  metadata    Json?       @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service? @relation(fields: [serviceId], references: [id])
  prices  Price[]

  @@index([code])
  @@index([moduleScope, isActive])
  @@index([serviceId])
  @@map("products")
  @@schema("billing")
}

model Price {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  code        String   @unique @db.VarChar(100)
  currency    String   @db.VarChar(10)
  amount      Decimal  @db.Decimal(19, 4)
  interval    String?  @db.VarChar(20) // month, year, none
  trialDays   Int?     @default(0) @map("trial_days")
  graceDays   Int?     @default(0) @map("grace_days")
  isActive    Boolean  @default(true) @map("is_active")
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders        Order[]
  subscriptions Subscription[]

  @@index([code])
  @@index([productId, isActive])
  @@map("prices")
  @@schema("billing")
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  priceId      String      @map("price_id") @db.Uuid
  mode         OrderMode
  status       OrderStatus @default(created)
  amount       Decimal     @db.Decimal(19, 4)
  currency     String      @db.VarChar(10)
  externalId   String?     @unique @map("external_id") @db.VarChar(255)
  metadata     Json?       @default("{}")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  price         Price            @relation(fields: [priceId], references: [id])
  paymentIntents PaymentIntent[]
  invoices      Invoice[]
  affiliateCommissions AffiliateCommission[]

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([externalId])
  @@index([status, createdAt])
  @@map("orders")
  @@schema("billing")
}

model PaymentIntent {
  id                  String      @id @default(uuid()) @db.Uuid
  orderId             String      @map("order_id") @db.Uuid
  rail                String      @db.VarChar(50)
  status              IntentStatus @default(created)
  providerIntentId    String?     @map("provider_intent_id") @db.VarChar(255)
  providerCheckoutId  String?     @map("provider_checkout_id") @db.VarChar(255)
  checkoutUrl         String?     @map("checkout_url") @db.Text
  method              String?     @db.VarChar(50) // pix, card, crypto, etc
  amount              Decimal     @db.Decimal(19, 4)
  currency            String      @db.VarChar(10)
  cryptoChainId       String?     @map("crypto_chain_id") @db.VarChar(50)
  cryptoToken         String?     @map("crypto_token") @db.VarChar(50)
  cryptoAmount        String?     @map("crypto_amount") @db.VarChar(100)
  receiverAddress     String?     @map("receiver_address") @db.VarChar(255)
  txHash              String?     @map("tx_hash") @db.VarChar(255)
  expiresAt           DateTime?   @map("expires_at") @db.Timestamptz(6)
  snapshot            Json?       @default("{}")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([providerIntentId, rail], name: "unique_provider_intent_rail")
  @@unique([txHash, rail], name: "unique_tx_hash_rail")
  @@index([status, createdAt])
  @@index([orderId])
  @@index([providerIntentId])
  @@index([txHash])
  @@map("payment_intents")
  @@schema("billing")
}

model Subscription {
  id                      String            @id @default(uuid()) @db.Uuid
  userId                  String            @map("user_id") @db.Uuid
  priceId                 String            @map("price_id") @db.Uuid
  status                  SubscriptionStatus @default(trialing)
  currentPeriodStart      DateTime          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd        DateTime          @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd       Boolean           @default(false) @map("cancel_at_period_end")
  providerSubscriptionId  String?           @map("provider_subscription_id") @db.VarChar(255)
  rail                    String?           @db.VarChar(50)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  price Price @relation(fields: [priceId], references: [id])

  @@index([userId, status])
  @@index([providerSubscriptionId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
  @@schema("billing")
}

model Entitlement {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  key       String            @db.VarChar(100)
  status    EntitlementStatus @default(active)
  value     Json?             @default("{}")
  source    EntitlementSource
  sourceId  String?           @map("source_id") @db.VarChar(255)
  startsAt  DateTime?         @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime?         @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, key, status])
  @@index([status, expiresAt])
  @@map("entitlements")
  @@schema("billing")
}

model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  status            InvoiceStatus @default(open)
  amount            Decimal       @db.Decimal(19, 4)
  currency          String        @db.VarChar(10)
  providerReceiptUrl String?      @map("provider_receipt_url") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("invoices")
  @@schema("billing")
}

model WebhookEvent {
  id          String             @id @default(uuid()) @db.Uuid
  rail        String             @db.VarChar(50)
  webhookId   String             @map("webhook_id") @db.VarChar(255)
  eventType   String             @map("event_type") @db.VarChar(100)
  entityId    String             @map("entity_id") @db.VarChar(255)
  payload     Json               @default("{}")
  receivedAt  DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(6)
  status      WebhookEventStatus @default(received)
  attempts    Int                @default(0)
  lastError   String?            @map("last_error") @db.Text

  @@unique([rail, webhookId])
  @@index([status, receivedAt])
  @@index([rail, entityId])
  @@map("webhook_events")
  @@schema("billing")
}

model OutboxEvent {
  id        String            @id @default(uuid()) @db.Uuid
  eventType String            @map("event_type") @db.VarChar(100)
  aggregate Json              @default("{}")
  payload   Json              @default("{}")
  status    OutboxEventStatus @default(new)
  attempts  Int               @default(0)
  lastError String?           @map("last_error") @db.Text
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt    DateTime?         @map("sent_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Asc)])
  @@index([eventType])
  @@map("outbox_events")
  @@schema("billing")
}

enum AffiliateStatus {
  active
  inactive
  suspended

  @@schema("billing")
}

enum CommissionStatus {
  pending
  earned
  paid
  voided

  @@schema("billing")
}

enum PayoutStatus {
  pending
  processing
  paid
  failed

  @@schema("billing")
}

model Affiliate {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  serviceId         String?          @map("service_id") @db.Uuid
  parentAffiliateId String?          @map("parent_affiliate_id") @db.Uuid
  referralCode      String           @unique @map("referral_code") @db.VarChar(50)
  status            AffiliateStatus  @default(active)
  commissionRate    Decimal          @default(0.5) @map("commission_rate") @db.Decimal(5, 4)
  totalEarned       Decimal          @default(0) @map("total_earned") @db.Decimal(19, 4)
  totalPaid         Decimal          @default(0) @map("total_paid") @db.Decimal(19, 4)
  metadata          Json?            @default("{}")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  service           Service?         @relation(fields: [serviceId], references: [id])
  parentAffiliate   Affiliate?       @relation("AffiliateTree", fields: [parentAffiliateId], references: [id])
  childAffiliates   Affiliate[]      @relation("AffiliateTree")
  referrals         Referral[]
  commissions       AffiliateCommission[]
  payouts           AffiliatePayout[]

  @@unique([userId, serviceId])
  @@index([referralCode])
  @@index([status])
  @@index([serviceId])
  @@index([parentAffiliateId])
  @@map("affiliates")
  @@schema("billing")
}

model Referral {
  id              String   @id @default(uuid()) @db.Uuid
  affiliateId     String   @map("affiliate_id") @db.Uuid
  referredUserId  String   @map("referred_user_id") @db.Uuid
  serviceId       String?  @map("service_id") @db.Uuid
  referralCode    String   @map("referral_code") @db.VarChar(50)
  firstOrderId    String?  @map("first_order_id") @db.Uuid
  firstOrderPaid  Boolean  @default(false) @map("first_order_paid")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  affiliate       Affiliate            @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  service         Service?             @relation(fields: [serviceId], references: [id])
  commissions     AffiliateCommission[]

  @@unique([referredUserId, serviceId])
  @@index([affiliateId])
  @@index([referredUserId])
  @@index([referralCode])
  @@index([serviceId])
  @@map("referrals")
  @@schema("billing")
}

model AffiliateCommission {
  id              String           @id @default(uuid()) @db.Uuid
  affiliateId     String           @map("affiliate_id") @db.Uuid
  referralId      String           @map("referral_id") @db.Uuid
  orderId         String           @map("order_id") @db.Uuid
  level           Int              @default(1)
  amount          Decimal          @db.Decimal(19, 4)
  commissionRate  Decimal          @map("commission_rate") @db.Decimal(5, 4)
  currency        String           @db.VarChar(10)
  status          CommissionStatus @default(pending)
  earnedAt        DateTime?        @map("earned_at") @db.Timestamptz(6)
  payoutId        String?          @map("payout_id") @db.Uuid
  metadata        Json?            @default("{}")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  affiliate       Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referral        Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payout          AffiliatePayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([affiliateId, status])
  @@index([orderId])
  @@index([status, earnedAt])
  @@index([payoutId])
  @@map("affiliate_commissions")
  @@schema("billing")
}

model AffiliatePayout {
  id              String       @id @default(uuid()) @db.Uuid
  affiliateId     String       @map("affiliate_id") @db.Uuid
  periodStart     DateTime     @map("period_start") @db.Timestamptz(6)
  periodEnd       DateTime     @map("period_end") @db.Timestamptz(6)
  totalAmount     Decimal      @map("total_amount") @db.Decimal(19, 4)
  currency        String       @db.VarChar(10)
  status          PayoutStatus @default(pending)
  payoutDate      DateTime?    @map("payout_date") @db.Timestamptz(6)
  processedAt     DateTime?    @map("processed_at") @db.Timestamptz(6)
  failureReason   String?      @map("failure_reason") @db.Text
  metadata        Json?        @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  affiliate       Affiliate            @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  commissions     AffiliateCommission[]

  @@index([affiliateId, status])
  @@index([status, periodEnd])
  @@index([periodStart, periodEnd])
  @@map("affiliate_payouts")
  @@schema("billing")
}

model PaymentProvider {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(50)    // ONE, LAVA, CRYPTO
  name           String   @db.VarChar(255)
  isActive       Boolean  @default(false) @map("is_active")
  supportedModes String[] @map("supported_modes")    // PAYMENT, SUBSCRIPTION
  currencies     String[] @default([])                // USD, EUR, BRL
  countries      String[] @default([])                // BR, US, EU, GLOBAL
  webhookUrl     String?  @map("webhook_url") @db.Text
  config         Json?    @default("{}")              // API keys, secrets (encrypted in prod)
  metadata       Json?    @default("{}")              // display info, logo, description
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("payment_providers")
  @@schema("billing")
}

