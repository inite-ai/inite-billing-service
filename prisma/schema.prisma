// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  schemas    = ["billing", "public"]
  extensions = [vector, pg_trgm]
}

// Billing schema - payment-rail agnostic billing and subscriptions

enum ProductType {
  subscription
  one_time
  usage

  @@schema("billing")
}

enum OrderMode {
  PAYMENT
  SUBSCRIPTION

  @@schema("billing")
}

enum OrderStatus {
  created
  open
  paid
  failed
  refunded
  expired

  @@schema("billing")
}

enum IntentStatus {
  created
  opened
  paid
  failed
  expired
  refunded

  @@schema("billing")
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  ended

  @@schema("billing")
}

enum EntitlementStatus {
  active
  revoked
  expired

  @@schema("billing")
}

enum EntitlementSource {
  subscription
  order
  admin

  @@schema("billing")
}

enum InvoiceStatus {
  open
  paid
  void
  failed
  refunded

  @@schema("billing")
}

enum WebhookEventStatus {
  received
  processing
  processed
  failed

  @@schema("billing")
}

enum OutboxEventStatus {
  new
  sent
  failed

  @@schema("billing")
}

model Service {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(100)
  name      String   @db.VarChar(255)
  apiKey    String   @unique @map("api_key") @db.VarChar(64)
  isActive            Boolean  @default(true) @map("is_active")
  webhookUrl          String?  @map("webhook_url") @db.VarChar(500)
  minWithdrawalAmount Decimal? @map("min_withdrawal_amount") @db.Decimal(19, 4)
  metadata            Json?    @default("{}")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products        Product[]
  referralLevels  ReferralLevel[]
  affiliates      Affiliate[]
  referrals       Referral[]
  promoCodes      PromoCode[]
  creditBalances  CreditBalance[]
  meteredFeatures MeteredFeature[]

  @@map("services")
  @@schema("billing")
}

model ReferralLevel {
  id                    String   @id @default(uuid()) @db.Uuid
  serviceId             String   @map("service_id") @db.Uuid
  level                 Int
  commissionRate        Decimal  @map("commission_rate") @db.Decimal(5, 4)
  name                  String   @db.VarChar(100)
  isActive              Boolean  @default(true) @map("is_active")
  qualificationCriteria Json?    @default("{}") @map("qualification_criteria")
  // qualificationCriteria JSON shape:
  // {
  //   minDirectReferrals?: number,     // min direct referrals to qualify
  //   minActiveReferrals?: number,     // min referrals with firstOrderPaid
  //   minPersonalOrders?: number,      // min personal orders (affiliate bought something)
  //   minDownlineOrders?: number,      // min paid orders across entire downline structure
  //   minMonthlyVolume?: number,       // min monthly sales volume from downline ($)
  //   personalPurchaseRequired?: bool, // affiliate must have own active subscription
  // }
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service @relation(fields: [serviceId], references: [id])

  @@unique([serviceId, level])
  @@map("referral_levels")
  @@schema("billing")
}

model Product {
  id          String      @id @default(uuid()) @db.Uuid
  code        String      @unique @db.VarChar(100)
  name        String      @db.VarChar(255)
  serviceId   String?     @map("service_id") @db.Uuid
  moduleScope String      @map("module_scope") @db.VarChar(100)
  type        ProductType
  isActive    Boolean     @default(true) @map("is_active")
  metadata    Json?       @default("{}")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service? @relation(fields: [serviceId], references: [id])
  prices  Price[]

  @@index([code])
  @@index([moduleScope, isActive])
  @@index([serviceId])
  @@map("products")
  @@schema("billing")
}

model Price {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  code        String   @unique @db.VarChar(100)
  currency    String   @db.VarChar(10)
  amount      Decimal  @db.Decimal(19, 4)
  interval    String?  @db.VarChar(20) // month, year, none
  trialDays   Int?     @default(0) @map("trial_days")
  graceDays   Int?     @default(0) @map("grace_days")
  isActive    Boolean  @default(true) @map("is_active")
  metadata    Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  orders        Order[]
  subscriptions Subscription[]

  @@index([code])
  @@index([productId, isActive])
  @@map("prices")
  @@schema("billing")
}

model Order {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @map("user_id") @db.VarChar(255)
  priceId      String      @map("price_id") @db.Uuid
  mode         OrderMode
  status       OrderStatus @default(created)
  amount       Decimal     @db.Decimal(19, 4)
  currency     String      @db.VarChar(10)
  externalId   String?     @unique @map("external_id") @db.VarChar(255)
  metadata     Json?       @default("{}")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  price         Price            @relation(fields: [priceId], references: [id])
  paymentIntents PaymentIntent[]
  invoices      Invoice[]
  riskAssessment RiskAssessment?
  affiliateCommissions AffiliateCommission[]
  promoCodeUsages PromoCodeUsage[]

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([externalId])
  @@index([status, createdAt])
  @@map("orders")
  @@schema("billing")
}

model PaymentIntent {
  id                  String      @id @default(uuid()) @db.Uuid
  orderId             String      @map("order_id") @db.Uuid
  rail                String      @db.VarChar(50)
  status              IntentStatus @default(created)
  providerIntentId    String?     @map("provider_intent_id") @db.VarChar(255)
  providerCheckoutId  String?     @map("provider_checkout_id") @db.VarChar(255)
  checkoutUrl         String?     @map("checkout_url") @db.Text
  method              String?     @db.VarChar(50) // pix, card, crypto, etc
  amount              Decimal     @db.Decimal(19, 4)
  currency            String      @db.VarChar(10)
  cryptoChainId       String?     @map("crypto_chain_id") @db.VarChar(50)
  cryptoToken         String?     @map("crypto_token") @db.VarChar(50)
  cryptoAmount        String?     @map("crypto_amount") @db.VarChar(100)
  receiverAddress     String?     @map("receiver_address") @db.VarChar(255)
  txHash              String?     @map("tx_hash") @db.VarChar(255)
  expiresAt           DateTime?   @map("expires_at") @db.Timestamptz(6)
  snapshot            Json?       @default("{}")
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([providerIntentId, rail], name: "unique_provider_intent_rail")
  @@unique([txHash, rail], name: "unique_tx_hash_rail")
  @@index([status, createdAt])
  @@index([orderId])
  @@index([providerIntentId])
  @@index([txHash])
  @@map("payment_intents")
  @@schema("billing")
}

model Subscription {
  id                      String            @id @default(uuid()) @db.Uuid
  userId                  String            @map("user_id") @db.VarChar(255)
  priceId                 String            @map("price_id") @db.Uuid
  status                  SubscriptionStatus @default(trialing)
  currentPeriodStart      DateTime          @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd        DateTime          @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd       Boolean           @default(false) @map("cancel_at_period_end")
  providerSubscriptionId  String?           @map("provider_subscription_id") @db.VarChar(255)
  rail                    String?           @db.VarChar(50)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  price Price @relation(fields: [priceId], references: [id])

  @@index([userId, status])
  @@index([providerSubscriptionId])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
  @@schema("billing")
}

model Entitlement {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.VarChar(255)
  key       String            @db.VarChar(100)
  status    EntitlementStatus @default(active)
  value     Json?             @default("{}")
  source    EntitlementSource
  sourceId  String?           @map("source_id") @db.VarChar(255)
  startsAt  DateTime?         @map("starts_at") @db.Timestamptz(6)
  expiresAt DateTime?         @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([userId, key, status])
  @@index([status, expiresAt])
  @@map("entitlements")
  @@schema("billing")
}

model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  status            InvoiceStatus @default(open)
  amount            Decimal       @db.Decimal(19, 4)
  currency          String        @db.VarChar(10)
  providerReceiptUrl String?      @map("provider_receipt_url") @db.Text
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("invoices")
  @@schema("billing")
}

model WebhookEvent {
  id          String             @id @default(uuid()) @db.Uuid
  rail        String             @db.VarChar(50)
  webhookId   String             @map("webhook_id") @db.VarChar(255)
  eventType   String             @map("event_type") @db.VarChar(100)
  entityId    String             @map("entity_id") @db.VarChar(255)
  payload     Json               @default("{}")
  receivedAt  DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt DateTime?          @map("processed_at") @db.Timestamptz(6)
  status      WebhookEventStatus @default(received)
  attempts    Int                @default(0)
  lastError   String?            @map("last_error") @db.Text

  @@unique([rail, webhookId])
  @@index([status, receivedAt])
  @@index([rail, entityId])
  @@map("webhook_events")
  @@schema("billing")
}

model OutboxEvent {
  id        String            @id @default(uuid()) @db.Uuid
  eventType String            @map("event_type") @db.VarChar(100)
  aggregate Json              @default("{}")
  payload   Json              @default("{}")
  status    OutboxEventStatus @default(new)
  attempts  Int               @default(0)
  lastError String?           @map("last_error") @db.Text
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt    DateTime?         @map("sent_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Asc)])
  @@index([eventType])
  @@map("outbox_events")
  @@schema("billing")
}

enum AffiliateStatus {
  active
  inactive
  suspended

  @@schema("billing")
}

enum CommissionStatus {
  pending
  earned
  paid
  voided

  @@schema("billing")
}

enum PayoutStatus {
  pending
  processing
  paid
  failed

  @@schema("billing")
}

model Affiliate {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.VarChar(255)
  serviceId         String?          @map("service_id") @db.Uuid
  parentAffiliateId String?          @map("parent_affiliate_id") @db.Uuid
  referralCode      String           @unique @map("referral_code") @db.VarChar(50)
  status            AffiliateStatus  @default(active)
  commissionRate    Decimal          @default(0.5) @map("commission_rate") @db.Decimal(5, 4)
  totalEarned       Decimal          @default(0) @map("total_earned") @db.Decimal(19, 4)
  totalPaid         Decimal          @default(0) @map("total_paid") @db.Decimal(19, 4)
  metadata          Json?            @default("{}")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  service           Service?         @relation(fields: [serviceId], references: [id])
  parentAffiliate   Affiliate?       @relation("AffiliateTree", fields: [parentAffiliateId], references: [id])
  childAffiliates   Affiliate[]      @relation("AffiliateTree")
  referrals         Referral[]
  commissions       AffiliateCommission[]
  payouts           AffiliatePayout[]

  @@unique([userId, serviceId])
  @@index([referralCode])
  @@index([status])
  @@index([serviceId])
  @@index([parentAffiliateId])
  @@map("affiliates")
  @@schema("billing")
}

model Referral {
  id              String   @id @default(uuid()) @db.Uuid
  affiliateId     String   @map("affiliate_id") @db.Uuid
  referredUserId  String   @map("referred_user_id") @db.VarChar(255)
  serviceId       String?  @map("service_id") @db.Uuid
  referralCode    String   @map("referral_code") @db.VarChar(50)
  firstOrderId    String?  @map("first_order_id") @db.Uuid
  firstOrderPaid  Boolean  @default(false) @map("first_order_paid")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  affiliate       Affiliate            @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  service         Service?             @relation(fields: [serviceId], references: [id])
  commissions     AffiliateCommission[]

  @@unique([referredUserId, serviceId])
  @@index([affiliateId])
  @@index([referredUserId])
  @@index([referralCode])
  @@index([serviceId])
  @@map("referrals")
  @@schema("billing")
}

model AffiliateCommission {
  id              String           @id @default(uuid()) @db.Uuid
  affiliateId     String           @map("affiliate_id") @db.Uuid
  referralId      String           @map("referral_id") @db.Uuid
  orderId         String           @map("order_id") @db.Uuid
  level           Int              @default(1)
  amount          Decimal          @db.Decimal(19, 4)
  commissionRate  Decimal          @map("commission_rate") @db.Decimal(5, 4)
  currency        String           @db.VarChar(10)
  status          CommissionStatus @default(pending)
  earnedAt        DateTime?        @map("earned_at") @db.Timestamptz(6)
  payoutId        String?          @map("payout_id") @db.Uuid
  metadata        Json?            @default("{}")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  affiliate       Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referral        Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payout          AffiliatePayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([affiliateId, status])
  @@index([orderId])
  @@index([status, earnedAt])
  @@index([payoutId])
  @@map("affiliate_commissions")
  @@schema("billing")
}

model AffiliatePayout {
  id               String        @id @default(uuid()) @db.Uuid
  affiliateId      String        @map("affiliate_id") @db.Uuid
  payoutProviderId String?       @map("payout_provider_id") @db.Uuid
  periodStart      DateTime      @map("period_start") @db.Timestamptz(6)
  periodEnd        DateTime      @map("period_end") @db.Timestamptz(6)
  totalAmount      Decimal       @map("total_amount") @db.Decimal(19, 4)
  feeAmount        Decimal?      @map("fee_amount") @db.Decimal(19, 4)
  netAmount        Decimal?      @map("net_amount") @db.Decimal(19, 4)
  currency         String        @db.VarChar(10)
  status           PayoutStatus  @default(pending)
  payoutDate       DateTime?     @map("payout_date") @db.Timestamptz(6)
  processedAt      DateTime?     @map("processed_at") @db.Timestamptz(6)
  externalId       String?       @map("external_id") @db.VarChar(255)
  failureReason    String?       @map("failure_reason") @db.Text
  payoutDetails    Json?         @map("payout_details") @default("{}")
  metadata         Json?         @default("{}")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  affiliate        Affiliate            @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  payoutProvider   PayoutProvider?      @relation(fields: [payoutProviderId], references: [id])
  commissions      AffiliateCommission[]

  @@index([affiliateId, status])
  @@index([status, periodEnd])
  @@index([periodStart, periodEnd])
  @@map("affiliate_payouts")
  @@schema("billing")
}

model PayoutProvider {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(50)    // BANK, CRYPTO, PAYPAL
  name           String   @db.VarChar(255)
  isActive       Boolean  @default(false) @map("is_active")
  currencies     String[] @default([])                // USD, EUR, USDT
  minAmount      Decimal? @map("min_amount") @db.Decimal(19, 4)
  maxAmount      Decimal? @map("max_amount") @db.Decimal(19, 4)
  feePercent     Decimal? @map("fee_percent") @db.Decimal(5, 4)
  feeFixed       Decimal? @map("fee_fixed") @db.Decimal(19, 4)
  config         Json?    @default("{}")              // API keys, secrets
  metadata       Json?    @default("{}")              // display info, description
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  payouts        AffiliatePayout[]

  @@map("payout_providers")
  @@schema("billing")
}

model PaymentProvider {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(50)    // ONE, LAVA, CRYPTO
  name           String   @db.VarChar(255)
  isActive       Boolean  @default(false) @map("is_active")
  supportedModes String[] @map("supported_modes")    // PAYMENT, SUBSCRIPTION
  currencies     String[] @default([])                // USD, EUR, BRL
  countries      String[] @default([])                // BR, US, EU, GLOBAL
  webhookUrl     String?  @map("webhook_url") @db.Text
  config         Json?    @default("{}")              // API keys, secrets (encrypted in prod)
  metadata       Json?    @default("{}")              // display info, logo, description
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("payment_providers")
  @@schema("billing")
}

model PromoCode {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique @db.VarChar(50)
  name              String   @db.VarChar(255)
  description       String?  @db.Text
  discountType      String   @map("discount_type") @db.VarChar(20) // percentage | fixed_amount
  discountValue     Decimal  @map("discount_value") @db.Decimal(19, 4)
  serviceId         String?  @map("service_id") @db.Uuid
  minPurchaseAmount Decimal? @map("min_purchase_amount") @db.Decimal(19, 4)
  maxDiscountAmount Decimal? @map("max_discount_amount") @db.Decimal(19, 4)
  validFrom         DateTime @map("valid_from") @db.Timestamptz(6)
  validUntil        DateTime? @map("valid_until") @db.Timestamptz(6)
  isActive          Boolean  @default(true) @map("is_active")
  maxUsageCount     Int?     @map("max_usage_count")
  currentUsageCount Int      @default(0) @map("current_usage_count")
  maxUsagePerUser   Int?     @default(1) @map("max_usage_per_user")
  metadata          Json?    @default("{}")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  service  Service? @relation(fields: [serviceId], references: [id])
  usages   PromoCodeUsage[]

  @@index([isActive, validFrom, validUntil])
  @@index([serviceId])
  @@map("promo_codes")
  @@schema("billing")
}

model PromoCodeUsage {
  id              String   @id @default(uuid()) @db.Uuid
  promoCodeId     String   @map("promo_code_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  userId          String   @map("user_id") @db.VarChar(255)
  discountApplied Decimal  @map("discount_applied") @db.Decimal(19, 4)
  originalAmount  Decimal  @map("original_amount") @db.Decimal(19, 4)
  finalAmount     Decimal  @map("final_amount") @db.Decimal(19, 4)
  appliedAt       DateTime @default(now()) @map("applied_at") @db.Timestamptz(6)

  promoCode PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([promoCodeId, userId])
  @@index([orderId])
  @@map("promo_code_usages")
  @@schema("billing")
}

model CreditBalance {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.VarChar(255)
  serviceId   String?  @map("service_id") @db.Uuid
  balance     Int      @default(0)
  totalGranted Int     @default(0) @map("total_granted")
  totalUsed   Int      @default(0) @map("total_used")
  resetsAt    DateTime? @map("resets_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  service     Service? @relation(fields: [serviceId], references: [id])
  usages      CreditUsage[]

  @@unique([userId, serviceId])
  @@index([userId])
  @@map("credit_balances")
  @@schema("billing")
}

model CreditUsage {
  id              String   @id @default(uuid()) @db.Uuid
  creditBalanceId String   @map("credit_balance_id") @db.Uuid
  userId          String   @map("user_id") @db.VarChar(255)
  amount          Int
  type            String   @db.VarChar(20)
  description     String?  @db.VarChar(255)
  orderId         String?  @map("order_id") @db.Uuid
  featureCode     String?  @map("feature_code") @db.VarChar(100)
  units           Int?
  modelTier       String?  @map("model_tier") @db.VarChar(50)
  metadata        Json?    @default("{}")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  creditBalance   CreditBalance @relation(fields: [creditBalanceId], references: [id], onDelete: Cascade)

  @@index([creditBalanceId, createdAt])
  @@index([userId, createdAt])
  @@index([userId, featureCode, createdAt])
  @@index([featureCode, createdAt])
  @@map("credit_usages")
  @@schema("billing")
}

model MeteredFeature {
  id             String   @id @default(uuid()) @db.Uuid
  code           String   @unique @db.VarChar(100)
  name           String   @db.VarChar(255)
  serviceId      String?  @map("service_id") @db.Uuid
  unit           String   @db.VarChar(30) // tokens | requests | generations | seconds
  creditsPerUnit Decimal  @default(1) @map("credits_per_unit") @db.Decimal(12, 6)
  tierRates      Json?    @default("{}") @map("tier_rates") // absolute per-unit overrides by modelTier
  isActive       Boolean  @default(true) @map("is_active")
  metadata       Json?    @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  service Service?       @relation(fields: [serviceId], references: [id])
  quotas  FeatureQuota[]

  @@index([serviceId, isActive])
  @@map("metered_features")
  @@schema("billing")
}

model FeatureQuota {
  id            String   @id @default(uuid()) @db.Uuid
  featureId     String?  @map("feature_id") @db.Uuid // null = balance-wide quota
  serviceId     String?  @map("service_id") @db.Uuid
  userId        String?  @map("user_id") @db.VarChar(255) // null = default for all users; set = per-user override
  window        String   @db.VarChar(20) // day | week | month | billing_period
  limitUnits    Int?     @map("limit_units")
  limitCredits  Int?     @map("limit_credits")
  softCapPct    Int      @default(80) @map("soft_cap_pct")
  overagePolicy String   @default("block") @map("overage_policy") @db.VarChar(20) // block | notify_only
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  feature MeteredFeature? @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([featureId, serviceId, userId, window])
  @@map("feature_quotas")
  @@schema("billing")
}

model Conversation {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.VarChar(255)
  mode       String        @db.VarChar(20) // admin | user
  status     String        @default("active") @db.VarChar(20) // active | resolved
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages   ChatMessage[]
  actions    AssistantAction[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("conversations")
  @@schema("billing")
}

model ChatMessage {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @map("conversation_id") @db.Uuid
  role            String    @db.VarChar(20) // user | assistant | tool
  content         String    @db.Text
  toolCalls       Json?     @map("tool_calls")
  toolResults     Json?     @map("tool_results")
  feedback        String?   @db.VarChar(10) // up | down
  feedbackComment String?   @map("feedback_comment") @db.Text
  feedbackAt      DateTime? @map("feedback_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
  @@schema("billing")
}

model AssistantToolCall {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  userId         String   @map("user_id") @db.VarChar(255)
  toolName       String   @map("tool_name") @db.VarChar(64)
  args           Json?
  resultPreview  String?  @map("result_preview") @db.Text // truncated to 1000 chars
  isError        Boolean  @default(false) @map("is_error")
  durationMs     Int      @map("duration_ms")
  iteration      Int      @default(0) // tool-use loop step (0-4)
  model          String?  @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([toolName, createdAt])
  @@index([conversationId, createdAt])
  @@map("assistant_tool_calls")
  @@schema("billing")
}

model AssistantAction {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  userId         String    @map("user_id") @db.VarChar(255) // proposer & only allowed approver
  toolName       String    @map("tool_name") @db.VarChar(64)
  toolUseId      String?   @map("tool_use_id") @db.VarChar(64) // Anthropic tool_use block id (audit)
  params         Json // validated params snapshot
  summary        String    @db.Text // server-generated human-readable description
  requiredRole   String?   @map("required_role") @db.VarChar(20) // null = user scope
  status         String    @default("pending") @db.VarChar(20)
  // pending | executing | executed | failed | rejected | expired
  result         Json?
  error          String?   @db.Text
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  confirmedAt    DateTime? @map("confirmed_at") @db.Timestamptz(6)
  confirmedBy    String?   @map("confirmed_by") @db.VarChar(255)
  executedAt     DateTime? @map("executed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([conversationId, createdAt])
  @@map("assistant_actions")
  @@schema("billing")
}

model ProductEmbedding {
  id          String                       @id @default(uuid()) @db.Uuid
  productId   String                       @unique @map("product_id") @db.Uuid
  content     String                       @db.Text
  contentHash String                       @map("content_hash") @db.VarChar(64)
  embedding   Unsupported("vector(1536)")?
  model       String                       @db.VarChar(100)
  updatedAt   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("product_embeddings")
  @@schema("billing")
}

enum NotificationChannel {
  in_app
  email

  @@schema("billing")
}

enum NotificationStatus {
  pending
  sent
  delivered
  failed
  skipped
  bounced

  @@schema("billing")
}

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @map("user_id") @db.VarChar(255)
  type              String              @db.VarChar(50) // dunning | winback | abandoned_checkout | trial_ending | quota_warning | system
  channel           NotificationChannel
  title             String              @db.VarChar(500) // email: subject
  body              String              @db.Text // plain text; email HTML rendered at send time
  status            NotificationStatus  @default(pending)
  readAt            DateTime?           @map("read_at") @db.Timestamptz(6) // in_app only
  emailTo           String?             @map("email_to") @db.VarChar(255)
  providerMessageId String?             @map("provider_message_id") @db.VarChar(255)
  attempts          Int                 @default(0)
  lastError         String?             @map("last_error") @db.Text
  metadata          Json?               @default("{}") // { outreachId, triggerKey, locale, ctaUrl }
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt            DateTime?           @map("sent_at") @db.Timestamptz(6)

  @@index([userId, channel, createdAt(sort: Desc)])
  @@index([userId, channel, readAt])
  @@index([status, createdAt])
  @@index([providerMessageId])
  @@map("notifications")
  @@schema("billing")
}

model UserContact {
  userId           String   @id @map("user_id") @db.VarChar(255)
  email            String?  @db.VarChar(255)
  locale           String   @default("en") @db.VarChar(10)
  emailSuppressed  Boolean  @default(false) @map("email_suppressed") // bounce/complaint
  unsubscribeToken String   @unique @default(uuid()) @map("unsubscribe_token") @db.VarChar(64)
  lastSeenAt       DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_contacts")
  @@schema("billing")
}

model NotificationPreference {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.VarChar(255)
  category     String   @db.VarChar(50) // dunning | winback | abandoned_checkout | trial_ending | quota_warning | all
  emailEnabled Boolean  @default(true) @map("email_enabled")
  inAppEnabled Boolean  @default(true) @map("in_app_enabled")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, category])
  @@map("notification_preferences")
  @@schema("billing")
}

model RiskAssessment {
  id         String    @id @default(uuid()) @db.Uuid
  orderId    String    @unique @map("order_id") @db.Uuid
  userId     String    @map("user_id") @db.VarChar(255)
  ip         String?   @db.VarChar(64)
  score      Int
  level      String    @db.VarChar(10) // low | medium | high
  signals    Json      @default("[]") // [{ code, weight, detail }]
  status     String    @default("none") @db.VarChar(20) // none | flagged | blocked | reviewed_ok | reviewed_fraud
  reviewedBy String?   @map("reviewed_by") @db.VarChar(255)
  reviewNote String?   @map("review_note") @db.VarChar(500)
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([userId, createdAt])
  @@index([ip, createdAt])
  @@map("risk_assessments")
  @@schema("billing")
}

model AiInsight {
  id        String   @id @default(uuid()) @db.Uuid
  kind      String   @db.VarChar(30) // 'funnel' (extensible)
  scopeKey  String   @map("scope_key") @db.VarChar(200) // sha1 of params
  locale    String   @default("en") @db.VarChar(5)
  content   String   @db.Text
  data      Json? // metrics snapshot fed to the model
  model     String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([kind, scopeKey, locale])
  @@map("ai_insights")
  @@schema("billing")
}

enum OutreachStatus {
  pending
  generated
  sent
  failed
  skipped

  @@schema("billing")
}

model OutreachMessage {
  id                  String    @id @default(uuid()) @db.Uuid
  userId              String    @map("user_id") @db.VarChar(255)
  trigger             String    @db.VarChar(50) // abandoned_checkout | dunning | winback | trial_ending
  step                Int       @default(0) // dunning: 0|2|5
  triggerKey          String    @unique @map("trigger_key") @db.VarChar(255) // idempotency across cron re-runs
  funnelEventId       String?   @map("funnel_event_id") @db.Uuid
  orderId             String?   @map("order_id") @db.Uuid
  subscriptionId      String?   @map("subscription_id") @db.Uuid
  locale              String    @db.VarChar(10)
  subject             String?   @db.VarChar(500)
  body                String?   @db.Text
  source              String?   @db.VarChar(20) // llm | template
  model               String?   @db.VarChar(100)
  inputTokens         Int?      @map("input_tokens")
  outputTokens        Int?      @map("output_tokens")
  status              OutreachStatus @default(pending)
  skipReason          String?   @map("skip_reason") @db.VarChar(100) // kill_switch | opted_out | rate_capped | no_email | resolved
  emailNotificationId String?   @map("email_notification_id") @db.Uuid
  inAppNotificationId String?   @map("in_app_notification_id") @db.Uuid
  outcome             String?   @db.VarChar(30) // converted | resolved | churned | none
  convertedAt         DateTime? @map("converted_at") @db.Timestamptz(6)
  error               String?   @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt              DateTime? @map("sent_at") @db.Timestamptz(6)

  @@index([userId, sentAt])
  @@index([trigger, status, createdAt])
  @@index([outcome, sentAt])
  @@map("outreach_messages")
  @@schema("billing")
}

model FunnelEvent {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.VarChar(255)
  sessionId   String?  @map("session_id") @db.VarChar(100)
  eventType   String   @map("event_type") @db.VarChar(50)
  // eventType values: catalog_view, checkout_started, payment_pending,
  //   payment_failed, payment_completed, subscription_created,
  //   subscription_renewed, subscription_canceled, subscription_churned,
  //   checkout_abandoned
  stage       String   @db.VarChar(30)
  // stage values: awareness, checkout, payment, conversion, retention, churned
  orderId     String?  @map("order_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  serviceId   String?  @map("service_id") @db.Uuid
  amount      Decimal? @db.Decimal(19, 4)
  currency    String?  @db.VarChar(10)
  properties  Json?    @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([stage, createdAt])
  @@index([orderId])
  @@index([serviceId, createdAt])
  @@map("funnel_events")
  @@schema("billing")
}

